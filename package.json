{
  "name": "solaris-bronceado",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "eslint",
    "prepare": "husky",
    "test": "vitest run",
    "setup:admin": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/setup-admin.ts",
