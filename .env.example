# Copy to .env.local for development. Production values go in Vercel → Settings → Environment Variables.

# ── MongoDB (Atlas) ──────────────────────────────────────────────────────────
# Local dev: docker run -d --name solaris-mongo -p 127.0.0.1:27018:27017 mongo:8
MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_DB=solaris

# ── Admin login — generate with: npm run setup:admin ─────────────────────────
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
AUTH_SECRET=

# ── Images (S3). Vercel reserves AWS_* names, hence S3_* ─────────────────────
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for uploaded images, no trailing slash, e.g.
# https://<bucket>.s3.<region>.amazonaws.com
NEXT_PUBLIC_IMAGE_BASE_URL=

# ── Blog draft CLI (npm run blog:draft) ──────────────────────────────────────
# Put the PRODUCTION values of MONGODB_URI, MONGODB_DB, S3_* and
# NEXT_PUBLIC_IMAGE_BASE_URL in .env.blog-draft (gitignored). The CLI only
# creates drafts; it needs no admin login variables.
